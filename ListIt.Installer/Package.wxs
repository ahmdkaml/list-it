<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="List-it"
      Manufacturer="List-it"
      Version="1.0.0"
      UpgradeCode="edcb382f-f182-43d2-b1bf-ba6f887bce02">

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="List-it">

        <Files Include="$(var.PublishDir)\**">
          <Exclude Files="$(var.PublishDir)\*.pdb" />
        </Files>

      </Directory>
    </StandardDirectory>

  </Package>

</Wix>
