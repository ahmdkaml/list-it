<Window x:Class="ListIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ListIt"
        Height="360" Width="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#18181B"
        ShowInTaskbar="False"
        Topmost="False"
        Closing="Window_Closing">

    <Border BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fixed Header (No Drag Cursor) -->
            <TextBlock Grid.Row="0" Text="TASKS" FontSize="11" FontWeight="Bold"
                       Foreground="#71717A" Margin="4,0,0,8" Cursor="Arrow"/>

            <!-- Todo Items List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TasksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Text}"
                                          IsChecked="{Binding IsDone}"
                                          Foreground="#E4E4E7"
                                          Click="TaskItem_Click"
                                          VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="×" FontSize="12"
                                        Background="Transparent" Foreground="#71717A"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="DeleteTask_Click" Margin="4,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input Box -->
            <TextBox Grid.Row="2" x:Name="NewTaskInput"
                     Background="#27272A" Foreground="#FAFAFA"
                     BorderBrush="#3F3F46" BorderThickness="1"
                     Padding="6,4" Margin="0,8,0,0"
                     KeyDown="NewTaskInput_KeyDown"/>
        </Grid>
    </Border>
</Window>
