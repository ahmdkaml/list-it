<Window x:Class="ListIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ListIt"
        Height="140" Width="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#18181B"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False">

    <Border BorderBrush="#3F3F46"
            BorderThickness="1"
            Padding="16"
            Cursor="SizeAll"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="LIST-IT"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#A1A1AA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="hello there"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
