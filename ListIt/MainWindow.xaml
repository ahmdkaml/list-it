<Window x:Class="ListIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ListIt.UI.Views"
        Title="ListIt"
        Height="140" Width="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#18181B"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False">

    <!-- Shell Box: Outer 8px padding/frame is the draggable grip -->
    <Border x:Name="ShellDragGrip"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            Padding="8"
            Cursor="SizeAll"
            Background="#18181B"
            MouseLeftButtonDown="ShellDragGrip_MouseLeftButtonDown">

        <!-- App UI View: Normal mouse interaction for all inner controls -->
        <views:AppView />
    </Border>
</Window>
