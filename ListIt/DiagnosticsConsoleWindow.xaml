<Window x:Class="ListIt.DiagnosticsConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ListIt.UI.Views;assembly=ListIt.UI"
        Title="ListIt - Timing &amp; Diagnostics Console"
        Height="540" Width="480"
        MinHeight="400" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Border BorderBrush="#3F3F46" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#27272A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="12,0,6,0">
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            DockPanel.Dock="Right"
                            Width="26" Height="22"
                            Background="Transparent"
                            Foreground="#A1A1AA"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="11"
                            VerticalAlignment="Center" />
                    <TextBlock Text="ListIt Timing &amp; Diagnostics Console"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Grid>

            <!-- Diagnostics Content -->
            <views:DiagnosticsConsoleView Grid.Row="1" />
        </Grid>
    </Border>
</Window>
