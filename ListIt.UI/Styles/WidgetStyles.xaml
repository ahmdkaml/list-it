<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme Colors -->
    <Color x:Key="WidgetBackgroundColor">#18181B</Color>
    <Color x:Key="WidgetBorderColor">#3F3F46</Color>
    <Color x:Key="WidgetHeaderColor">#A1A1AA</Color>
    <Color x:Key="WidgetBodyColor">#FFFFFF</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="{StaticResource WidgetBackgroundColor}" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="{StaticResource WidgetBorderColor}" />
    <SolidColorBrush x:Key="WidgetHeaderBrush" Color="{StaticResource WidgetHeaderColor}" />
    <SolidColorBrush x:Key="WidgetBodyBrush" Color="{StaticResource WidgetBodyColor}" />

    <!-- TextBlock Styles -->
    <Style x:Key="WidgetHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource WidgetHeaderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="WidgetBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource WidgetBodyBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ComboBoxItem Style -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#27272A" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#3F3F46" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2563EB" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
