<UserControl x:Class="ListIt.UI.Views.AppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:ListIt.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="300"
             Background="#18181B"
             Cursor="Arrow"
             MouseLeftButtonDown="AppView_MouseLeftButtonDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ListIt.UI;component/Styles/WidgetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <!-- Main Task List View (visible when Editor is closed) -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Add Action -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button Content="+ New"
                        Command="{Binding OpenCreateTaskCommand}"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="10,4"
                        FontWeight="SemiBold"
                        FontSize="11"
                        DockPanel.Dock="Right" />
                <TextBlock Text="LIST-IT"
                           Foreground="#A1A1AA"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Task List -->
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Tasks}"
                         SelectedItem="{Binding SelectedTask}"
                         Background="#27272A"
                         BorderBrush="#3F3F46"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                                <Border.ContextMenu>
                                    <ContextMenu Background="#27272A" BorderBrush="#3F3F46">
                                        <MenuItem Header="Done"
                                                  Command="{Binding DataContext.DoneTaskCommand, RelativeSource={RelativeSource AncestorType=views:AppView}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="#FFFFFF" />
                                        <MenuItem Header="{Binding WorkActionText}"
                                                  Command="{Binding DataContext.WorkTaskCommand, RelativeSource={RelativeSource AncestorType=views:AppView}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="#FFFFFF" />
                                        <Separator Background="#3F3F46" />
                                        <MenuItem Header="Edit"
                                                  Command="{Binding DataContext.OpenEditTaskCommand, RelativeSource={RelativeSource AncestorType=views:AppView}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="#FFFFFF" />
                                        <MenuItem Header="Delete"
                                                  Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=views:AppView}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="#EF4444" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick Complete Button -->
                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.DoneTaskCommand, RelativeSource={RelativeSource AncestorType=views:AppView}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasPendingOccurrence}"
                                            ToolTip="Mark as Done"
                                            Width="18" Height="18"
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderBrush="#71717A"
                                            BorderThickness="1"
                                            Foreground="#10B981"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="9" />
                                            </Style>
                                        </Button.Resources>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                        <Setter Property="Content" Value="✓" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding HasPendingOccurrence}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#4B5563" />
                                                        <Setter Property="Foreground" Value="#4B5563" />
                                                        <Setter Property="Content" Value="✓" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Item Body -->
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title and Type Badge -->
                                        <DockPanel Grid.Row="0">
                                            <Border Background="#3F3F46" CornerRadius="3" Padding="4,1" DockPanel.Dock="Right" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding TypeDisplay}" Foreground="#D4D4D8" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                            <Border CornerRadius="3" Padding="4,1" DockPanel.Dock="Right" Margin="4,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2563EB" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateDisplay}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                                <Setter Property="Background" Value="#10B981" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SchedulingState}" Value="Overdue">
                                                                <Setter Property="Background" Value="#DC2626" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SchedulingState}" Value="Completed">
                                                                <Setter Property="Background" Value="#4B5563" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateDisplay}" Foreground="#FFFFFF" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#FFFFFF"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <!-- Details & Urgency -->
                                        <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="[Bypass] " Foreground="#38BDF8" FontSize="9" FontWeight="SemiBold"
                                                           Visibility="{Binding BypassPrioritySuppression, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Urgency, StringFormat='Urgency: {0}'}"
                                                           Foreground="#F59E0B"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DetailsDisplay}"
                                                       Foreground="#A1A1AA"
                                                       FontSize="10" />
                                        </DockPanel>

                                        <!-- Description (if present) -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Description}"
                                                   Foreground="#71717A"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Message -->
                <TextBlock Text="No tasks yet.&#x0a;Click '+ New' to create one."
                           Foreground="#71717A"
                           FontSize="12"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Bottom Toolbar: Actions -->
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Done"
                            Command="{Binding DoneTaskCommand}"
                            IsEnabled="{Binding CanCompleteSelectedTask}"
                            Background="#10B981"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Padding="8,4"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Margin="3,0,0,0" />
                    <Button Content="{Binding WorkButtonText}"
                            Command="{Binding WorkTaskCommand}"
                            IsEnabled="{Binding CanWorkSelectedTask}"
                            Background="#2563EB"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Padding="8,4"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Margin="3,0,0,0" />
                    <Button Content="Edit"
                            Command="{Binding OpenEditTaskCommand}"
                            IsEnabled="{Binding HasSelectedTask}"
                            Background="#3F3F46"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Padding="8,4"
                            FontSize="11"
                            Margin="3,0,0,0" />
                    <Button Content="Delete"
                            Command="{Binding DeleteTaskCommand}"
                            IsEnabled="{Binding HasSelectedTask}"
                            Background="#DC2626"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Padding="8,4"
                            FontWeight="SemiBold"
                            FontSize="11"
                            Margin="3,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Tasks.Count, StringFormat='{}{0} task(s)'}"
                           Foreground="#71717A"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <!-- Task Editor Overlay (visible when IsEditorOpen is true) -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <views:TaskEditorView DataContext="{Binding Editor}" />
        </Grid>
    </Grid>
</UserControl>
