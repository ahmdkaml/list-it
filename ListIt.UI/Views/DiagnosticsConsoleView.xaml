<UserControl x:Class="ListIt.UI.Views.DiagnosticsConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="450"
             Background="#18181B">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ListIt.UI;component/Styles/WidgetStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Background="#27272A"
                        Foreground="#E4E4E7"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        Padding="8,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0,0,6,0" />
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Background="#3F3F46"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="8,4"
                        FontSize="11"
                        FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="TIMING &amp; DIAGNOSTICS CONSOLE"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Bold" />
                <TextBlock Text="Real-time intervals, countdowns, and halving alerts"
                           Foreground="#71717A"
                           FontSize="10" />
            </StackPanel>
        </DockPanel>

        <!-- Main Tasks List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#27272A"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Top Row: Title & Badges -->
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <!-- Pass Count Badge -->
                                        <Border CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F59E0B" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPasses}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasMultiplePasses}" Value="True">
                                                            <Setter Property="Background" Value="#DC2626" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PassesDisplay}" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" />
                                        </Border>

                                        <!-- Priority Score Badge -->
                                        <Border Background="#312E81" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding ScoreDisplay}" Foreground="#A5B4FC" FontSize="9" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Status Badge -->
                                        <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="#38BDF8" FontSize="9" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Type Badge -->
                                        <Border Background="#3F3F46" CornerRadius="3" Padding="4,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding TypeDisplay}" Foreground="#D4D4D8" FontSize="9" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#FFFFFF"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Interval Progress Section -->
                                <DockPanel Margin="0,4,0,2">
                                    <TextBlock Text="{Binding IntervalDisplay, StringFormat='Interval: {0}'}"
                                               Foreground="#A1A1AA"
                                               FontSize="10"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Text="{Binding ProgressDisplay, StringFormat='Interval Elapsed: {0}'}"
                                               Foreground="#A1A1AA"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </DockPanel>

                                <!-- Progress Bar -->
                                <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}"
                                             Minimum="0" Maximum="100"
                                             Height="5"
                                             Background="#18181B"
                                             Foreground="#2563EB"
                                             BorderBrush="#3F3F46"
                                             BorderThickness="0"
                                             Margin="0,2,0,8" />

                                <!-- Diagnostics Grid -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Deadline & Window Start -->
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="CURRENT WINDOW START" Foreground="#71717A" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding IntervalStartDisplay}" Foreground="#E4E4E7" FontSize="11" Margin="0,1,0,6" />

                                        <TextBlock Text="NEXT PASS / DEADLINE" Foreground="#71717A" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DeadlineDisplay}" Foreground="#E4E4E7" FontSize="11" Margin="0,1,0,2" />

                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="Deadline in:" Foreground="#A1A1AA" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding DeadlineCountdown}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" />
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Right: Halving Alerts & Steps -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="NEXT HALVING ALERT" Foreground="#71717A" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding NextHalvingAlertDisplay}" Foreground="#E4E4E7" FontSize="11" Margin="0,1,0,2" TextTrimming="CharacterEllipsis" />

                                        <DockPanel Margin="0,1,0,6">
                                            <TextBlock Text="Alert in:" Foreground="#A1A1AA" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding NextHalvingCountdown}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                                        </DockPanel>

                                        <TextBlock Text="HALVING STEPS ELAPSED" Foreground="#71717A" FontSize="9" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AlertStepsSummary}" Foreground="#94A3B8" FontSize="10" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
