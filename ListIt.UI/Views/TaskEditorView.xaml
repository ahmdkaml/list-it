<UserControl x:Class="ListIt.UI.Views.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:ListIt.Core.Models;assembly=ListIt.Core"
             xmlns:vm="clr-namespace:ListIt.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="280"
             Background="#18181B">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header -->
            <TextBlock Text="{Binding EditorTitle}"
                       Foreground="#FFFFFF"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

            <!-- Title -->
            <TextBlock Text="Title" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,2" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Background="#27272A"
                     Foreground="#FFFFFF"
                     CaretBrush="#FFFFFF"
                     BorderBrush="#3F3F46"
                     Padding="4,2"
                     Margin="0,0,0,8" />

            <!-- Description -->
            <TextBlock Text="Description" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,2" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Background="#27272A"
                     Foreground="#FFFFFF"
                     CaretBrush="#FFFFFF"
                     BorderBrush="#3F3F46"
                     Padding="4,2"
                     Height="40"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8" />

            <!-- Task Type -->
            <TextBlock Text="Task Type" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,2" />

            <!-- Type Selector ComboBox -->
            <ComboBox SelectedValue="{Binding SelectedType}"
                      SelectedValuePath="Tag"
                      IsEnabled="{Binding IsTypeSelectionEnabled}"
                      Background="#27272A"
                      Foreground="#FFFFFF"
                      BorderBrush="#3F3F46"
                      Margin="0,0,0,8">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#27272A" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />
                </ComboBox.Resources>
                <ComboBoxItem Content="Recurring (repeats indefinitely)" Tag="{x:Static models:TaskType.Recurring}" />
                <ComboBoxItem Content="Finite (fixed completions)" Tag="{x:Static models:TaskType.Finite}" />
            </ComboBox>

            <!-- Interval -->
            <TextBlock Text="Interval" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,2" />
            <ComboBox SelectedValue="{Binding SelectedIntervalPreset}"
                      SelectedValuePath="Tag"
                      Background="#27272A"
                      Foreground="#FFFFFF"
                      BorderBrush="#3F3F46"
                      Margin="0,0,0,4">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#27272A" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />
                </ComboBox.Resources>
                <ComboBoxItem Content="1 Day (24 hours)" Tag="{x:Static vm:IntervalPreset.Day}" />
                <ComboBoxItem Content="1 Week (7 days)" Tag="{x:Static vm:IntervalPreset.Week}" />
                <ComboBoxItem Content="1 Month (30 days)" Tag="{x:Static vm:IntervalPreset.Month}" />
                <ComboBoxItem Content="Custom Interval..." Tag="{x:Static vm:IntervalPreset.Custom}" />
            </ComboBox>
            <TextBox Text="{Binding IntervalString, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsCustomInterval, Converter={StaticResource BoolToVis}}"
                     Background="#27272A"
                     Foreground="#FFFFFF"
                     CaretBrush="#FFFFFF"
                     BorderBrush="#3F3F46"
                     Padding="4,2"
                     Margin="0,0,0,8" />

            <!-- Start Time -->
            <TextBlock Text="Start Time" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,2" />
            <ComboBox SelectedValue="{Binding SelectedStartTimeMode}"
                      SelectedValuePath="Tag"
                      Background="#27272A"
                      Foreground="#FFFFFF"
                      BorderBrush="#3F3F46"
                      Margin="0,0,0,4">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#27272A" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />
                </ComboBox.Resources>
                <ComboBoxItem Content="Now (Assignment Time)" Tag="{x:Static vm:StartTimeMode.Now}" />
                <ComboBoxItem Content="Specific Time / Hour..." Tag="{x:Static vm:StartTimeMode.SpecificHour}" />
            </ComboBox>
            <TextBox Text="{Binding StartTimeString, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsSpecificStartTime, Converter={StaticResource BoolToVis}}"
                     Background="#27272A"
                     Foreground="#FFFFFF"
                     CaretBrush="#FFFFFF"
                     BorderBrush="#3F3F46"
                     Padding="4,2"
                     Margin="0,0,0,8" />

            <!-- Urgency (1 to 6) -->
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Urgency:" Foreground="#A1A1AA" FontSize="11" />
                <TextBlock Text="{Binding Urgency}" Foreground="#FFFFFF" FontWeight="Bold" Margin="4,0,0,0" />
            </DockPanel>
            <Slider Minimum="1" Maximum="6" Value="{Binding Urgency}"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,0,0,8" />

            <!-- Priority Suppression Bypass -->
            <CheckBox IsChecked="{Binding BypassPrioritySuppression}"
                      Foreground="#FFFFFF"
                      Margin="0,0,0,2">
                <TextBlock Text="Bypass priority suppression" Foreground="#FFFFFF" FontSize="11" />
            </CheckBox>
            <TextBlock Text="Allow notifications for this task even when lower-priority notifications are suppressed by a higher-priority task."
                       Foreground="#71717A"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="18,0,0,8" />

            <!-- Finite Specific Section -->
            <StackPanel Visibility="{Binding IsFinite, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Required Completions" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,2" />
                <TextBox Text="{Binding RequiredCompletions, UpdateSourceTrigger=PropertyChanged}"
                         Background="#27272A"
                         Foreground="#FFFFFF"
                         CaretBrush="#FFFFFF"
                         BorderBrush="#3F3F46"
                         Padding="4,2"
                         Margin="0,0,0,8" />
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#EF4444"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}" />

            <!-- Action Buttons -->
            <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="0,6"
                        FontWeight="SemiBold"
                        Margin="0,0,4,0" />
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Background="#3F3F46"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="0,6"
                        Margin="4,0,0,0" />
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
