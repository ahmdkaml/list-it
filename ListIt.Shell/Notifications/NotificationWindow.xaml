<Window x:Class="ListIt.Shell.Notifications.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="320"
        SizeToContent="Height"
        Focusable="True">

    <Border Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="3"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left accent stripe -->
            <Border Grid.Column="0"
                    Background="{Binding AccentBrush}"
                    CornerRadius="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <!-- Header: Icon, Title, and Category Badge -->
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Border DockPanel.Dock="Right"
                            Background="{Binding AccentBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CategoryBadgeText}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔔 "
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="180"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Details Grid -->
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding UrgencyText}"
                               Foreground="{Binding TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="Medium"
                               Margin="0,2" />

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding SkipCountText}"
                               Foreground="{Binding TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding ElapsedText}"
                               Foreground="{Binding TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding RemainingText}"
                               Foreground="{Binding TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,2" />
                </Grid>

                <!-- Actions Placeholder (Display-Only for Phase 4.2) -->
                <UniformGrid Columns="2" Margin="0,2,0,0">
                    <Button Content="Work"
                            Margin="0,0,4,0"
                            Height="26"
                            Background="{Binding ButtonBackgroundBrush}"
                            Foreground="{Binding TextPrimaryBrush}"
                            BorderThickness="0"
                            FontSize="11"
                            FontWeight="Medium"
                            Focusable="False"
                            IsHitTestVisible="False" />

                    <Button Content="Done"
                            Margin="4,0,0,0"
                            Height="26"
                            Background="{Binding ButtonBackgroundBrush}"
                            Foreground="{Binding TextPrimaryBrush}"
                            BorderThickness="0"
                            FontSize="11"
                            FontWeight="Medium"
                            Focusable="False"
                            IsHitTestVisible="False" />
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
